{
  "workdir": "${OUTPUT_PARENT}",
  "run_name": "${RUN_NAME}",
  "seed": 0,
  "primary_device": "cuda:0",
  "map_every": 1,
  "keyframe_every": 8,
  "keyframe_selection_mode": "accum_motion_redundancy",
  "accum_motion_redundancy": {
    "base_gap": 8,
    "min_gap": 4,
    "max_gap": 16,
    "min_target_dist": 0.03,
    "target_dist_scale": 1.0,
    "threshold_scale": 1.0,
    "jitter_dist_ratio": 0.35,
    "jitter_rot_deg": 5.0,
    "jitter_hold_ratio": 0.5,
    "recent_refs": 3,
    "downsample": 96,
    "duplicate_l1": 0.025,
    "duplicate_grad_l1": 0.02,
    "min_edge_ratio": 0.65,
    "min_contrast_ratio": 0.6,
    "feature_downsample": 128,
    "feature_max_disp": 4,
    "feature_corr_temp": 0.5,
    "feature_duplicate_mae": 0.025,
    "feature_duplicate_flow": 0.1,
    "feature_duplicate_grad": 0.92,
    "log_every": 25
  },
  "dynamic_mapping_iters": {
    "enable": true,
    "base_gap": 8,
    "power": 1.0,
    "max_scale": 3.0,
    "min_iters": 25,
    "max_iters": 75,
    "log_every": 25
  },
  "fold_seg_loss": {
    "enable": false,
    "root": "${FOLD_ROOT}",
    "channel": 0,
    "low": 0.0,
    "high": 1.0,
    "probability_clip": true,
    "weight": 1.0,
    "memory_efficient_backward": true
  },
  "temporal_deformation": {
    "enable": false,
    "num_basis": 2,
    "fold_soft_alpha": 0.5,
    "log_every": 25
  },
  "mapping_window_size": -1,
  "report_global_progress_every": 2000,
  "eval_every": 8,
  "scene_radius_depth_ratio": 3,
  "mean_sq_dist_method": "projective",
  "gaussian_distribution": "isotropic",
  "report_iter_progress": false,
  "load_checkpoint": false,
  "checkpoint_time_idx": 0,
  "save_checkpoints": false,
  "checkpoint_interval": 10000000000,
  "use_wandb": false,
  "data": {
    "basedir": "${DATASET_ROOT}",
    "gradslam_data_cfg": "${CAMERA_CONFIG}",
    "sequence": "c2_transverse2_t3_v3",
    "desired_image_height": 540,
    "desired_image_width": 675,
    "start": 0,
    "end": -1,
    "stride": 1,
    "num_frames": -1
  },
  "tracking": {
    "use_gt_poses": false,
    "forward_prop": true,
    "num_iters": 15,
    "use_sil_for_loss": true,
    "sil_thres": 0.99,
    "use_l1": true,
    "ignore_outlier_depth_loss": false,
    "loss_weights": {
      "im": 0.5,
      "depth": 1.0
    },
    "lrs": {
      "means3D": 0.0,
      "rgb_colors": 0.0,
      "unnorm_rotations": 0.0,
      "logit_opacities": 0.0,
      "log_scales": 0.0,
      "cam_unnorm_rots": 0.002,
      "cam_trans": 0.005,
      "deform_coeffs": 0.0
    },
    "use_depth_loss_thres": false,
    "depth_loss_thres": 100000,
    "visualize_tracking_loss": false
  },
  "mapping": {
    "num_iters": 25,
    "add_new_gaussians": true,
    "sil_thres": 0.5,
    "use_l1": true,
    "use_sil_for_loss": false,
    "ignore_outlier_depth_loss": false,
    "loss_weights": {
      "im": 1.0,
      "depth": 1.0,
      "def_mag": 0.001,
      "def_temp": 0.01,
      "def_mean": 0.01
    },
    "lrs": {
      "means3D": 0.0001,
      "rgb_colors": 0.0025,
      "unnorm_rotations": 0.001,
      "logit_opacities": 0.05,
      "log_scales": 0.001,
      "cam_unnorm_rots": 0.0,
      "cam_trans": 0.0,
      "deform_coeffs": 0.0001
    },
    "prune_gaussians": true,
    "pruning_dict": {
      "start_after": 0,
      "remove_big_after": 0,
      "stop_after": 20,
      "prune_every": 20,
      "removal_opacity_threshold": 0.005,
      "final_removal_opacity_threshold": 0.005,
      "reset_opacities": false,
      "reset_opacities_every": 10000000000
    },
    "use_gaussian_splatting_densification": false,
    "densify_dict": {
      "start_after": 500,
      "remove_big_after": 3000,
      "stop_after": 5000,
      "densify_every": 100,
      "grad_thresh": 0.0002,
      "num_to_split_into": 2,
      "removal_opacity_threshold": 0.005,
      "final_removal_opacity_threshold": 0.005,
      "reset_opacities_every": 3000
    }
  },
  "viz": {
    "render_mode": "color",
    "offset_first_viz_cam": true,
    "show_sil": false,
    "visualize_cams": false,
    "viz_w": 320,
    "viz_h": 320,
    "viz_near": 0.01,
    "viz_far": 100.0,
    "view_scale": 2,
    "viz_fps": 30,
    "enter_interactive_post_online": true,
    "gaussian_simplification": false
  },
  "selection_ablation": {
    "mode": "motion_proposal_only",
    "monogs_interval": 10,
    "monogs_overlap": 0.95,
    "monogs_translation": 0.04,
    "monogs_min_translation": 0.02,
    "force_kf_interval": false,
    "notes": "SplaTAM post-mapping selection. Native MonoGS n_touched renderer used only for visibility; both views rerendered on current map to avoid stale/pruned point IDs; first 10 retained keyframes use bootstrap overlap. SplaTAM replay pool unchanged."
  }
}